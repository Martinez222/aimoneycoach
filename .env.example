# Database Configuration
# Local demo:
AIMONEYCOACH_DATABASE_URL=sqlite+aiosqlite:///./aimoneycoach.db
# Hosted Postgres example:
# AIMONEYCOACH_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# GROQ AI Configuration
AIMONEYCOACH_GROQ_API_KEY=your_groq_api_key_here
AIMONEYCOACH_GROQ_MODEL=mixtral-8x7b-32768

# JWT Configuration
AIMONEYCOACH_JWT_SECRET_KEY=your_super_secret_key_change_me
AIMONEYCOACH_JWT_ALGORITHM=HS256
AIMONEYCOACH_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Configuration
AIMONEYCOACH_DEBUG=True
AIMONEYCOACH_ENVIRONMENT=development

# CORS Configuration
AIMONEYCOACH_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8000"]
